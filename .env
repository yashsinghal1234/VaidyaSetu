# ──────────────────────────────────────────────
# FHIRBridge MCP — Environment Configuration
# ──────────────────────────────────────────────

# FHIR Server (use HAPI FHIR public sandbox for testing)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_AUTH_TYPE=none          # options: none | bearer | smart

# SMART on FHIR (only if FHIR_AUTH_TYPE=smart)
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
SMART_TOKEN_URL=

# Static bearer token (only if FHIR_AUTH_TYPE=bearer)
FHIR_BEARER_TOKEN=

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Cache TTL in seconds
CACHE_TTL=300
